# Only the migration database credential is injected into database commands.
PGHOST=op://CommonRecordInfra/neon-production-db/host
PGDATABASE=op://CommonRecordInfra/neon-production-db/database
PGUSER=op://CommonRecordInfra/neon-production-db/migration-user
PGPASSWORD=op://CommonRecordInfra/neon-production-db/migration-password
PGSSLMODE=require
